Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # CGI/FastCGI auf geteiltem Hosting schluckt den Authorization-Header;
    # ohne diese Zeile kommt kein Token im PHP an.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Die Startseite ausdruecklich: mod_rewrite laeuft vor DirectoryIndex, /garage/ ist fuer
    # die Bedingung unten keine Datei und landete sonst als 404 in der Bruecke.
    RewriteRule ^$ index.html [L]

    # Vorhandene Dateien (Oberflaeche, Assets) direkt ausliefern, alles andere an die Bruecke.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
