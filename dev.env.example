# Vorlage für die lokale Entwicklung: kopieren nach app/.env.local
GARAGE_BASE_URL='http://localhost:8081'
GARAGE_DB_HOST='localhost'
GARAGE_DB_NAME='garage_dev'
GARAGE_DB_USER='garage'
GARAGE_DB_PASSWORD=''
# Nur Buchstaben und Ziffern: php -r "echo bin2hex(random_bytes(32));"
GARAGE_DEPLOY_TOKEN=''
# nur lokal: Cookies ohne Secure, damit sie auf http://localhost ankommen. Auf Strato nie setzen.
GARAGE_INSECURE_COOKIES='1'
# Nur Buchstaben und Ziffern, mindestens 64 Zeichen: php -r "echo bin2hex(random_bytes(48));"
GARAGE_JWT_SECRET=''
